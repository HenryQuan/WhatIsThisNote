  "lessonFiveLinesTitle": "The five lines",
  "lessonMeetStaffTitle": "Meet the staff",
  "lessonMeetStaffBody": "Music is written on a staff of five lines. Higher on the staff means a higher pitch. In the treble clef this middle line is B.",
  "lessonLinesTitle": "Lines spell E G B D F",
  "lessonLinesBody": "Notes on the lines are a third apart. One line down from B is G.",
  "lessonBottomLineTitle": "The bottom line",
  "lessonBottomLineBody": "The bottom line is E. Read the lines from the bottom up: E, G, B, D, F.",
  "lessonYourTurnTitle": "Your turn",
  "lessonLinesPracticeBody": "Drag the note down to the middle line (B).",
  "lessonSpacesTitle": "The spaces",
  "lessonSpacesSpellTitle": "Spaces spell F A C E",
  "lessonSpacesSpellBody": "Notes in the spaces sit between the lines. The first space from the bottom is F.",
  "lessonUpSpacesTitle": "Up the spaces",
  "lessonUpSpacesBody": "The spaces from the bottom up are F, A, C, E.",
  "lessonSpacesPracticeBody": "Drag the note to the top space (E).",
  "lessonBassClefTitle": "The bass clef",
  "lessonLowerClefTitle": "A lower clef",
  "lessonLowerClefBody": "The bass clef is used for low instruments. Its middle line is D.",
  "lessonBassBottomLineBody": "The bottom line of the bass staff is G, and the lines spell G, B, D, F, A.",
  "lessonBassPracticeBody": "Drag the note up to the middle line (D).",
  "lessonSharpsFlatsTitle": "Sharps and flats",
  "lessonSharpsTitle": "Sharps",
  "lessonSharpsBody": "A sharp raises a note by a half step. In G major every F becomes F sharp, written in the key signature.",
  "lessonFlatsTitle": "Flats",
  "lessonFlatsBody": "A flat lowers a note by a half step. In F major every B becomes B flat.",
  "lessonSharpsPracticeBody": "In G major the F is sharp. Drag the note to the top line (F).",
  "lessonAccidentalsTitle": "Accidentals",
  "lessonSharpTitle": "Sharp",
  "lessonSharpBody": "A sharp (\u266F) raises a note by a half step. This F cannot be written in C major without a sign, so a sharp is printed in front of it, making it F\u266F.",
  "lessonFlatTitle": "Flat",
  "lessonFlatBody": "A flat (\u266D) lowers a note by a half step. This B becomes B\u266D, with a flat sign in front of it.",
  "lessonNaturalTitle": "Natural",
  "lessonNaturalBody": "A natural (\u266E) cancels an earlier sharp or flat. In G major the key signature makes every F sharp, so an F natural needs a natural sign.",
  "lessonAccidentalsPracticeBody": "Drag the note up to F and make it F\u266F.",

